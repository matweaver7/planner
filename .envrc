# Parent .envrc — single source of truth for all connection config.
#
# Component variables are defined here; docker-compose.yml reads the same vars.
# Connection strings are constructed from the components below.
#
# Override for a specific service by setting values in that service's .env file.
# Each service's .envrc calls `source_up` (inherits this file) then
# `dotenv_if_exists .env` (loads .env on top, so .env wins).
#
# Requires direnv: https://direnv.net — run `direnv allow` after editing.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
export POSTGRES_HOST=localhost
export POSTGRES_PORT=3433
export POSTGRES_USER=planner
export POSTGRES_PASSWORD=planner
export POSTGRES_DB=planner_auth

export DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── MongoDB ───────────────────────────────────────────────────────────────────
export MONGO_HOST=localhost
export MONGO_PORT=27017
export MONGO_USER=
export MONGO_PASSWORD=
export MONGO_DB=planner_data

# No credentials included for local dev (MONGO_USER is empty).
# Set MONGO_USER + MONGO_PASSWORD in planner-data/.env for authenticated deployments.
export MONGODB_URL="mongodb://${MONGO_HOST}:${MONGO_PORT}"
export MONGODB_DB_NAME="${MONGO_DB}"

# ── Internal services ─────────────────────────────────────────────────────────
export AUTH_SERVICE_HOST=localhost
export AUTH_SERVICE_PORT=3001
export AUTH_SERVICE_URL="http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}"

export ACCOUNTS_SERVICE_HOST=localhost
export ACCOUNTS_SERVICE_PORT=3002
export ACCOUNTS_SERVICE_URL="http://${ACCOUNTS_SERVICE_HOST}:${ACCOUNTS_SERVICE_PORT}"

export PLANNER_SERVICE_HOST=localhost
export PLANNER_SERVICE_PORT=3003
export PLANNER_DATA_SERVICE_URL="http://${PLANNER_SERVICE_HOST}:${PLANNER_SERVICE_PORT}"

# ── Proxy ─────────────────────────────────────────────────────────────────────
export PROXY_HOST=localhost
export PROXY_PORT=3000
export VITE_API_BASE_URL="http://${PROXY_HOST}:${PROXY_PORT}"

# ── Frontend ──────────────────────────────────────────────────────────────────
export FRONTEND_HOST=localhost
export FRONTEND_PORT=5173
export CORS_ORIGINS="http://${FRONTEND_HOST}:${FRONTEND_PORT}"

# ── JWT (auth-service-specific — set in auth/.env, not here) ──────────────────
# export JWT_SECRET=change_me_in_production
# export JWT_ALGORITHM=HS256
# export JWT_EXPIRY_HOURS=24
