# Copy this file to .env and fill in real values before running locally.

# asyncpg DSN — no +asyncpg prefix, asyncpg uses its own DSN format
DATABASE_URL=postgresql://planner:planner@localhost:5432/planner_auth

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_in_production

# JWT settings (defaults are fine for most cases)
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
